# Copy to .env (git-ignored) and adjust. Every value has a default in tests/config.py.
USER_URL=http://localhost:8081
PRODUCT_URL=http://localhost:8082
ORDER_URL=http://localhost:8083
STORE_URL=http://localhost:8084
GATEWAY_URL=http://localhost:8080
EUREKA_URL=http://localhost:8761

# direct: each call goes to the owning service's port; gateway: every call goes to GATEWAY_URL
BASE_MODE=direct

# Must match user-service's SUPER_ADMIN_EMAIL / SUPER_ADMIN_INITIAL_PASSWORD. Unset = local dev defaults in
# tests/config.py. NEW is what the suite changes the password to on first run (12-128 chars, policy applies).
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_INITIAL_PASSWORD=
# SUPER_ADMIN_NEW_PASSWORD=

# Optional: path of api-gateway's application.yml, used to check the routing table (test skipped if missing)
GATEWAY_CONFIG_PATH=../api-gateway/src/main/resources/application.yml

HTTP_TIMEOUT_SECONDS=15
